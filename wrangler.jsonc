{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nova-vpn",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "4fe2e2c8-1a65-4216-83ed-0edcc10da6be","database_name": "nova-proxy" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "6888f00814f64668b532fecf60d05134" }
  ],
  "vars": {
    "PAGES_URL": "https://nova-panel.github.io"
  },
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
